Authorization: Bearer {{alice.access_token}}

?? status == 200
?? js ahead(response.parsedBody) == -203248
?? js response.parsedBody.plannedIncome == 203248
?? js response.parsedBody.plannedExpenses == 406496
?? js response.parsedBody.plannedExpensesExTransfers == 0
?? js response.parsedBody.budgetRemaining == -203248
?? js sum7(response.parsedBody) == 0

