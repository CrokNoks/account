@api = http://localhost:{{port}}
@supabase = http://127.0.0.1:54321

# Local stack only. Lancement : npx httpyac send --all functions/http/operations-pointage.http --var port=<port du back local> --var anon=<ANON_KEY de `supabase status`>
# (la clé vient de la ligne de commande, jamais du fichier). Alice et Bob sont des utilisateurs jetables créés par le fichier ;
# le compte et la période sont créés ici aussi, rien n'est supprimé à la fin (données jetables).
# Refonte Opérations : états À pointer / Facture à venir / Pointée, filtres reconciled + pending + ids, pointage et dépointage.

{{
  exports.tag = 'pt' + Date.now();
}}

### Alice (propriétaire jetable)
# @name aliceLogin
POST {{supabase}}/auth/v1/signup
apikey: {{anon}}
Content-Type: application/json

{"email":"pointage-alice-{{$timestamp}}@example.com","password":"Password123!"}

?? status == 200

### Bob (autre utilisateur connecté, non membre)
# @name bobLogin
POST {{supabase}}/auth/v1/signup
apikey: {{anon}}
Content-Type: application/json

{"email":"pointage-bob-{{$timestamp}}@example.com","password":"Password123!"}

?? status == 200

### Compte courant d'Alice
# @name courantAcc
POST {{api}}/accounts
Authorization: Bearer {{aliceLogin.access_token}}
Content-Type: application/json

{"name":"pointage-{{$timestamp}}","initialBalance":"0"}

?? status == 201

### Période d'octobre 2026 (sans budget)
# @name periodAcc
POST {{api}}/{{courantAcc.id}}/periods
Authorization: Bearer {{aliceLogin.access_token}}
Content-Type: application/json

{"startDate":"2026-10-01","endDate":"2026-10-31","budgets":[]}

?? status == 201

### Les 4 combinaisons : CB à pointer (faux, faux)
# @name cb
POST {{api}}/{{courantAcc.id}}/transactions
Authorization: Bearer {{aliceLogin.access_token}}
Content-Type: application/json

{"date":"2026-10-15T00:00:00.000Z","amount":"-1234","description":"{{tag}} cb"}

?? status == 201
?? js response.parsedBody.reconciled == false
?? js response.parsedBody.pending == false

### Facture à venir (faux, vrai)
# @name facture
POST {{api}}/{{courantAcc.id}}/transactions
Authorization: Bearer {{aliceLogin.access_token}}
Content-Type: application/json

{"date":"2026-10-15T00:00:00.000Z","amount":"-2345","description":"{{tag}} facture","pending":true}

?? status == 201
?? js response.parsedBody.reconciled == false
?? js response.parsedBody.pending == true

### Pointée (vrai, faux)
# @name pointee
POST {{api}}/{{courantAcc.id}}/transactions
Authorization: Bearer {{aliceLogin.access_token}}
Content-Type: application/json

{"date":"2026-10-15T00:00:00.000Z","amount":"-3456","description":"{{tag}} pointee","reconciled":true}

?? status == 201
?? js response.parsedBody.reconciled == true
?? js response.parsedBody.pending == false

### Pending rapprochée (vrai, vrai) : créée avec les deux
# @name pendingRapprochee
POST {{api}}/{{courantAcc.id}}/transactions
Authorization: Bearer {{aliceLogin.access_token}}
Content-Type: application/json

{"date":"2026-10-15T00:00:00.000Z","amount":"-4567","description":"{{tag}} pendingrapprochee","reconciled":true,"pending":true}

?? status == 201
?? js response.parsedBody.reconciled == true
?? js response.parsedBody.pending == true

### Filtre « À pointer » : seulement la CB
GET {{api}}/{{courantAcc.id}}/transactions?search={{tag}}&reconciled=false&pending=false
Authorization: Bearer {{aliceLogin.access_token}}

?? status == 200
?? js response.parsedBody.meta.total == 1
?? body contains "{{tag}} cb"
?? js response.body.includes(tag + ' facture') == false

### Filtre « Factures à venir » : la facture, pas la pending rapprochée
GET {{api}}/{{courantAcc.id}}/transactions?search={{tag}}&reconciled=false&pending=true
Authorization: Bearer {{aliceLogin.access_token}}

?? status == 200
?? js response.parsedBody.meta.total == 1
?? body contains "{{tag}} facture"
?? js response.body.includes('pendingrapprochee') == false

### Filtre « Pointées » (pending non envoyé) : les deux pointées, dont la pending rapprochée
GET {{api}}/{{courantAcc.id}}/transactions?search={{tag}}&reconciled=true
Authorization: Bearer {{aliceLogin.access_token}}

?? status == 200
?? js response.parsedBody.meta.total == 2
?? body contains "{{tag}} pointee"
?? body contains "{{tag}} pendingrapprochee"

### pending=true seul : facture + pending rapprochée
GET {{api}}/{{courantAcc.id}}/transactions?search={{tag}}&pending=true
Authorization: Bearer {{aliceLogin.access_token}}

?? status == 200
?? js response.parsedBody.meta.total == 2

### Sans filtre d'état : les 4
GET {{api}}/{{courantAcc.id}}/transactions?search={{tag}}
Authorization: Bearer {{aliceLogin.access_token}}

?? status == 200
?? js response.parsedBody.meta.total == 4

### pending=maybe est refusé
GET {{api}}/{{courantAcc.id}}/transactions?pending=maybe
Authorization: Bearer {{aliceLogin.access_token}}

?? status == 400

### N d'Aujourd'hui = lignes « À pointer » de la période (cardCount des stats)
# @name stats
GET {{api}}/{{courantAcc.id}}/periods/{{periodAcc.id}}/reporting/stats
Authorization: Bearer {{aliceLogin.access_token}}

?? status == 200

###
GET {{api}}/{{courantAcc.id}}/transactions?periodId={{periodAcc.id}}&reconciled=false&pending=false&limit=1
Authorization: Bearer {{aliceLogin.access_token}}

?? status == 200
?? js response.parsedBody.meta.total == {{stats.cardCount}}

### Filtre ids : exactement les lignes demandées
GET {{api}}/{{courantAcc.id}}/transactions?ids={{cb.id}},{{facture.id}}
Authorization: Bearer {{aliceLogin.access_token}}

?? status == 200
?? js response.parsedBody.meta.total == 2

### Filtre ids : identifiant invalide refusé
GET {{api}}/{{courantAcc.id}}/transactions?ids={{cb.id}},pas-un-uuid
Authorization: Bearer {{aliceLogin.access_token}}

?? status == 400

### Filtre ids : un autre utilisateur ne reçoit rien de ces identifiants (200 et liste vide : l'accès est filtré par RLS, pas de 403 sur cette route)
GET {{api}}/{{courantAcc.id}}/transactions?ids={{cb.id}}
Authorization: Bearer {{bobLogin.access_token}}

?? status == 200
?? js response.parsedBody.meta.total == 0
?? js response.body.includes(cb.id) == false

### Second compte d'Alice
# @name autreAcc
POST {{api}}/accounts
Authorization: Bearer {{aliceLogin.access_token}}
Content-Type: application/json

{"name":"pointage-autre-{{$timestamp}}","initialBalance":"0"}

?? status == 201

### Filtre ids : les identifiants d'un autre compte (même propriétaire) sont exclus
GET {{api}}/{{autreAcc.id}}/transactions?ids={{cb.id}},{{facture.id}}
Authorization: Bearer {{aliceLogin.access_token}}

?? status == 200
?? js response.parsedBody.meta.total == 0

### Anonyme : refusé
GET {{api}}/{{courantAcc.id}}/transactions?reconciled=false&pending=false

?? status == 401

### Pointer la facture à venir : elle sort de l'attente (resolvePending inchangée)
PATCH {{api}}/{{courantAcc.id}}/transactions/{{facture.id}}
Authorization: Bearer {{aliceLogin.access_token}}
Content-Type: application/json

{"reconciled":true}

?? status == 200
?? js response.parsedBody.reconciled == true
?? js response.parsedBody.pending == false

### Dépointer : elle redevient « À pointer » (pending non restaurée)
PATCH {{api}}/{{courantAcc.id}}/transactions/{{facture.id}}
Authorization: Bearer {{aliceLogin.access_token}}
Content-Type: application/json

{"reconciled":false}

?? status == 200
?? js response.parsedBody.reconciled == false
?? js response.parsedBody.pending == false

### « Remettre en facture à venir » : pending seul, reste non rapprochée
PATCH {{api}}/{{courantAcc.id}}/transactions/{{facture.id}}
Authorization: Bearer {{aliceLogin.access_token}}
Content-Type: application/json

{"pending":true}

?? status == 200
?? js response.parsedBody.reconciled == false
?? js response.parsedBody.pending == true

### Pointage en lot de la CB et de la facture
PATCH {{api}}/{{courantAcc.id}}/transactions/bulk
Authorization: Bearer {{aliceLogin.access_token}}
Content-Type: application/json

{"ids":["{{cb.id}}","{{facture.id}}"],"data":{"reconciled":true}}

?? status == 200

###
GET {{api}}/{{courantAcc.id}}/transactions?search={{tag}}&reconciled=false&pending=false
Authorization: Bearer {{aliceLogin.access_token}}

?? status == 200
?? js response.parsedBody.meta.total == 0
