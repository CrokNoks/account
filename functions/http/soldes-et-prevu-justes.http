?? js response.parsedBody.forecastBalance == 175000

### CA9 : créer une transaction pointée ET pending : 400
POST {{baseUrl}}/{{accA.id}}/transactions
Authorization: Bearer {{alice.access_token}}
Content-Type: application/json

{ "date": "2026-10-15", "description": "ca9 deux à vrai", "amount": "-100", "reconciled": true, "pending": true }

?? status == 400

### CA9 : une facture pending créée seule reste acceptée
# @name facture
POST {{baseUrl}}/{{accA.id}}/transactions
Authorization: Bearer {{alice.access_token}}
Content-Type: application/json

{ "date": "2026-10-15", "description": "ca9 facture", "amount": "-100", "pending": true }

?? status == 201
?? js response.parsedBody.pending == true
?? js response.parsedBody.reconciled == false

### CA9 : modifier avec reconciled et pending à vrai dans le corps : 400
PATCH {{baseUrl}}/{{accA.id}}/transactions/{{facture.id}}
Authorization: Bearer {{alice.access_token}}
Content-Type: application/json

{ "reconciled": true, "pending": true }

?? status == 400

### CA9 : pointer la facture retire pending
PATCH {{baseUrl}}/{{accA.id}}/transactions/{{facture.id}}
Authorization: Bearer {{alice.access_token}}
Content-Type: application/json

{ "reconciled": true }

?? status == 200
?? js response.parsedBody.reconciled == true
?? js response.parsedBody.pending == false

### CA9 : pending: true sur une pointée : 400
PATCH {{baseUrl}}/{{accA.id}}/transactions/{{facture.id}}
Authorization: Bearer {{alice.access_token}}
Content-Type: application/json

{ "pending": true }

?? status == 400

### CA9 : dépointer et remettre en facture dans le même corps : accepté
PATCH {{baseUrl}}/{{accA.id}}/transactions/{{facture.id}}
Authorization: Bearer {{alice.access_token}}
Content-Type: application/json

{ "reconciled": false, "pending": true }

?? status == 200
?? js response.parsedBody.reconciled == false
?? js response.parsedBody.pending == true

### CA9 (lot) : une ligne invalide sur trois, tout est refusé et rien n'est écrit
POST {{baseUrl}}/{{accA.id}}/transactions/bulk
Authorization: Bearer {{alice.access_token}}
Content-Type: application/json

{ "transactions": [
  { "date": "2026-10-16", "description": "ca9 lot ok 1", "amount": "-100" },
  { "date": "2026-10-16", "description": "ca9 lot ko", "amount": "-100", "reconciled": true, "pending": true },
  { "date": "2026-10-16", "description": "ca9 lot ok 2", "amount": "-100" } ] }

?? status == 400

###
GET {{baseUrl}}/{{accA.id}}/transactions?search=ca9 lot
Authorization: Bearer {{alice.access_token}}

?? status == 200
?? js response.parsedBody.meta.total == 0

### CA9 (lot de modification) : une pointée créée pour le lot
# @name pointee
POST {{baseUrl}}/{{accA.id}}/transactions
Authorization: Bearer {{alice.access_token}}
Content-Type: application/json

{ "date": "2026-10-17", "description": "ca9 pointee", "amount": "-100", "reconciled": true }

?? status == 201

### CA9 (lot de modification) : pending: true sur un lot dont une ligne est pointée : 400, rien n'est écrit
PATCH {{baseUrl}}/{{accA.id}}/transactions/bulk
Authorization: Bearer {{alice.access_token}}
Content-Type: application/json

{ "ids": ["{{facture.id}}", "{{pointee.id}}"], "data": { "pending": true } }

?? status == 400

### CA9 (lot de modification) : la facture, elle, n'a pas bougé (toujours en facture, jamais pointée)
GET {{baseUrl}}/{{accA.id}}/transactions?ids={{facture.id}}
Authorization: Bearer {{alice.access_token}}

?? status == 200
?? js response.parsedBody.data[0].pending == true
?? js response.parsedBody.data[0].reconciled == false

### CA9 (lot de modification) : pointer le lot (facture + pointée) retire pending, 200
PATCH {{baseUrl}}/{{accA.id}}/transactions/bulk
Authorization: Bearer {{alice.access_token}}
Content-Type: application/json

{ "ids": ["{{facture.id}}", "{{pointee.id}}"], "data": { "reconciled": true } }

?? status == 200

