POST {{baseUrl}}/{{accA.id}}/transactions
Authorization: Bearer {{alice.access_token}}
Content-Type: application/json

{ "categoryId": "{{prime.id}}", "date": "2026-11-05", "description": "prochaine paie", "amount": "12000", "pending": true }

?? status == 201

