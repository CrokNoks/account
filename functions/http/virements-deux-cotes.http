Authorization: Bearer {{bob.access_token}}
Content-Type: application/json

{"amount":"7000"}

?? status == 200
?? js response.parsedBody.amount == 7000

###
GET {{api}}/{{ax.id}}/transactions
Authorization: Bearer {{alice.access_token}}

?? status == 200
?? js response.parsedBody.data.find(t => t.id == t4[0].id).amount == -7000

