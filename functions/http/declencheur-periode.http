@api = http://localhost:{{port}}
@supabase = http://127.0.0.1:54321/auth/v1

# Déclencheur de période (spec declencheur-periode). Local stack only (Supabase local 127.0.0.1:54321), jamais le projet lié.
# Lancement : npx httpyac send --all functions/http/declencheur-periode.http --var port=<port du back local> --var anon=<clé publishable de `supabase status`>
# (la clé vient de la ligne de commande, jamais du fichier). Utilisateurs, comptes et catégories sont jetables, créés par le fichier ;
# rien n'est supprimé à la fin. Les dates sont relatives à « aujourd'hui » (fuseau Europe/Paris, comme le back).
# Non couvert ici (deux appels simultanés) : supabase/tests/period_trigger_test.sql + deux sessions psql (voir le résumé du cycle).

{{
  const paris = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Paris', year: 'numeric', month: '2-digit', day: '2-digit' });
  const base = new Date(paris.format(new Date()) + 'T00:00:00Z');
  exports.day = (offset) => new Date(base.getTime() + offset * 86400000).toISOString().slice(0, 10);
  exports.today = exports.day(0);
  exports.dm60 = exports.day(-60);
  exports.dm10 = exports.day(-10);
  exports.dm11 = exports.day(-11);
  exports.dm9 = exports.day(-9);
  exports.dm1 = exports.day(-1);
  exports.dp1 = exports.day(1);
  exports.dp5 = exports.day(5);
  exports.dp12 = exports.day(12);
  exports.dp19 = exports.day(19);
  exports.dp20 = exports.day(20);
  exports.dp30 = exports.day(30);
  exports.dayOfPay = Number(exports.day(20).slice(8, 10));
  exports.dm80 = exports.day(-80);
  exports.dm79 = exports.day(-79);
  exports.dm50 = exports.day(-50);
  exports.dm49 = exports.day(-49);
  exports.dm20 = exports.day(-20);
  exports.dm19 = exports.day(-19);
  exports.dm120 = exports.day(-120);
  exports.dm45 = exports.day(-45);
  exports.dm30 = exports.day(-30);
  exports.dm28 = exports.day(-28);
  exports.dm5 = exports.day(-5);
  exports.dm3 = exports.day(-3);
}}

### Alice (propriétaire jetable)
# @name alice
POST {{supabase}}/signup
apikey: {{anon}}
Content-Type: application/json

{ "email": "dp-alice-{{$timestamp}}@example.com", "password": "Password123!" }

?? status == 200

### Bob (autre utilisateur connecté, non membre puis lecture seule)
# @name bob
POST {{supabase}}/signup
apikey: {{anon}}
Content-Type: application/json

{ "email": "dp-bob-{{$timestamp}}@example.com", "password": "Password123!" }

?? status == 200

# ======================================================================
# Compte 1 : réglage (CA1) et bascule à la création (CA2)
# ======================================================================

### Compte 1
# @name acc1
POST {{api}}/accounts
Authorization: Bearer {{alice.access_token}}
Content-Type: application/json

{ "name": "dp1-{{$timestamp}}", "initialBalance": "0" }

?? status == 201

### Catégorie Salaire (revenu)
# @name sal1
POST {{api}}/{{acc1.id}}/categories
Authorization: Bearer {{alice.access_token}}
Content-Type: application/json

{ "name": "Salaire", "color": "#22aa55", "type": "income" }

?? status == 201

### Catégorie Courses (dépense)
# @name bills1
POST {{api}}/{{acc1.id}}/categories
Authorization: Bearer {{alice.access_token}}
Content-Type: application/json

{ "name": "Courses", "color": "#aa2255", "type": "expense" }

?? status == 201

### Période active commencée il y a 60 jours
# @name per1
POST {{api}}/{{acc1.id}}/periods
Authorization: Bearer {{alice.access_token}}
Content-Type: application/json

{ "startDate": "{{dm60}}", "endDate": "{{dp30}}", "budgets": [] }

?? status == 201

### CA1 : rien n'est marqué par défaut
GET {{api}}/{{acc1.id}}/categories
Authorization: Bearer {{alice.access_token}}

?? status == 200
?? js response.parsedBody.every(c => c.isPeriodTrigger === false) == true

### Sans marque, une paie ne bascule rien (réglage vide = fonctionnalité éteinte)
# @name noTrigger
POST {{api}}/{{acc1.id}}/transactions
Authorization: Bearer {{alice.access_token}}
Content-Type: application/json

{ "categoryId": "{{sal1.id}}", "date": "{{dm10}}", "description": "Paie sans marque", "amount": "200000" }

?? status == 201
?? js JSON.stringify(response.parsedBody).includes('periodSwitch') == false

### CA1 : Alice marque Salaire
PATCH {{api}}/{{acc1.id}}/categories/{{sal1.id}}
Authorization: Bearer {{alice.access_token}}
Content-Type: application/json

{ "isPeriodTrigger": true }

?? status == 200
?? js response.parsedBody.isPeriodTrigger == true

### CA1 : marquer Courses retire la marque de Salaire (une seule par compte)
PATCH {{api}}/{{acc1.id}}/categories/{{bills1.id}}
Authorization: Bearer {{alice.access_token}}
Content-Type: application/json

{ "isPeriodTrigger": true }

?? status == 200

### CA1 : une seule marque
GET {{api}}/{{acc1.id}}/categories
Authorization: Bearer {{alice.access_token}}

?? status == 200
?? js response.parsedBody.filter(c => c.isPeriodTrigger).length == 1
?? js response.parsedBody.find(c => c.name == 'Salaire').isPeriodTrigger == false

### CA1 : retour sur Salaire
PATCH {{api}}/{{acc1.id}}/categories/{{sal1.id}}
Authorization: Bearer {{alice.access_token}}
Content-Type: application/json

{ "isPeriodTrigger": true }

?? status == 200
?? js response.parsedBody.isPeriodTrigger == true

### CA1 : renommer sans toucher au réglage garde la marque (le back n'appelle pas la fonction du réglage)
PATCH {{api}}/{{acc1.id}}/categories/{{sal1.id}}
Authorization: Bearer {{alice.access_token}}
Content-Type: application/json

{ "name": "Salaire renomme" }

?? status == 200
?? js response.parsedBody.isPeriodTrigger == true
?? body contains "name":"Salaire renomme"

### CA1 : Bob (autre utilisateur connecté) ne voit pas la catégorie : 404
PATCH {{api}}/{{acc1.id}}/categories/{{sal1.id}}
Authorization: Bearer {{bob.access_token}}
Content-Type: application/json

{ "isPeriodTrigger": false }

?? status == 404

### CA1 : anonyme refusé
PATCH {{api}}/{{acc1.id}}/categories/{{sal1.id}}
Content-Type: application/json

{ "isPeriodTrigger": false }

?? status == 401

### CA1 : valeur invalide refusée
PATCH {{api}}/{{acc1.id}}/categories/{{sal1.id}}
Authorization: Bearer {{alice.access_token}}
Content-Type: application/json

{ "isPeriodTrigger": null }

?? status == 400

### CA4 : paie en pending (même ancienne) : aucune bascule
# @name pendingPay
POST {{api}}/{{acc1.id}}/transactions
Authorization: Bearer {{alice.access_token}}
Content-Type: application/json

{ "categoryId": "{{sal1.id}}", "date": "{{dm10}}", "description": "Paie pending", "amount": "200000", "pending": true }

?? status == 201
?? js JSON.stringify(response.parsedBody).includes('periodSwitch') == false

### CA4 : paie datée de demain : aucune bascule
POST {{api}}/{{acc1.id}}/transactions
Authorization: Bearer {{alice.access_token}}
Content-Type: application/json

{ "categoryId": "{{sal1.id}}", "date": "{{dp1}}", "description": "Paie demain", "amount": "200000" }

?? status == 201
?? js JSON.stringify(response.parsedBody).includes('periodSwitch') == false

### CA4 : transaction d'une autre catégorie : aucune bascule
POST {{api}}/{{acc1.id}}/transactions
Authorization: Bearer {{alice.access_token}}
Content-Type: application/json

{ "categoryId": "{{bills1.id}}", "date": "{{dm10}}", "description": "Courses", "amount": "-4500" }

?? status == 201
?? js JSON.stringify(response.parsedBody).includes('periodSwitch') == false

### Dépense déjà saisie, datée après la future date de bascule (sera rattachée à la nouvelle période)
# @name early
POST {{api}}/{{acc1.id}}/transactions
Authorization: Bearer {{alice.access_token}}
Content-Type: application/json

{ "categoryId": "{{bills1.id}}", "date": "{{dm9}}", "description": "Saisie avant la bascule", "amount": "-1000" }

?? status == 201

### CA2 : paie datée d'il y a 10 jours : l'active est close à la veille, la nouvelle commence ce jour-là
# @name switch1
POST {{api}}/{{acc1.id}}/transactions
Authorization: Bearer {{alice.access_token}}
Content-Type: application/json

{ "categoryId": "{{sal1.id}}", "date": "{{dm10}}", "description": "Paie bascule", "amount": "200000" }

?? status == 201
?? js response.parsedBody.periodSwitch.closed.id == {{per1.id}}
?? js response.parsedBody.periodSwitch.closed.endDate == {{dm11}}
?? js response.parsedBody.periodSwitch.opened.startDate == {{dm10}}
?? js response.parsedBody.periodSwitch.count == 1
?? js response.parsedBody.periodId == {{switch1.periodSwitch.opened.id}}

### CA2 : une seule période active, la nouvelle ; l'ancienne est close la veille
GET {{api}}/{{acc1.id}}/periods
Authorization: Bearer {{alice.access_token}}

?? status == 200
?? js response.parsedBody.filter(p => p.isActive).length == 1

### CA2 : la nouvelle période est l'active et commence à la date de la paie
GET {{api}}/{{acc1.id}}/periods/{{switch1.periodSwitch.opened.id}}
Authorization: Bearer {{alice.access_token}}

?? status == 200
?? js response.parsedBody.isActive == true
?? js response.parsedBody.startDate.slice(0, 10) == {{dm10}}

### CA2 : l'ancienne période est close la veille et inactive
GET {{api}}/{{acc1.id}}/periods/{{per1.id}}
Authorization: Bearer {{alice.access_token}}

?? status == 200
?? js response.parsedBody.isActive == false
?? js response.parsedBody.endDate.slice(0, 10) == {{dm11}}

### CA2 : la dépense saisie après le début de la nouvelle période lui est rattachée, comptée une fois
GET {{api}}/{{acc1.id}}/transactions?search=Saisie avant la bascule
Authorization: Bearer {{alice.access_token}}

?? status == 200
?? js response.parsedBody.data.length == 1
?? js response.parsedBody.data[0].periodId == {{switch1.periodSwitch.opened.id}}

### CA4 : une nouvelle paie à moins de 15 jours du début de la période ouverte : enregistrée sans bascule
POST {{api}}/{{acc1.id}}/transactions
Authorization: Bearer {{alice.access_token}}
Content-Type: application/json

{ "categoryId": "{{sal1.id}}", "date": "{{dm9}}", "description": "Paie trop proche", "amount": "1000" }

?? status == 201
?? js JSON.stringify(response.parsedBody).includes('periodSwitch') == false

### CA5 : un utilisateur non membre ne déclenche rien (404 du compte), anonyme refusé
POST {{api}}/{{acc1.id}}/transactions
Authorization: Bearer {{bob.access_token}}
Content-Type: application/json

{ "categoryId": "{{sal1.id}}", "date": "{{dm1}}", "description": "Paie Bob", "amount": "200000" }

?? status >= 400
?? status < 500

###
POST {{api}}/{{acc1.id}}/transactions
Content-Type: application/json

{ "categoryId": "{{sal1.id}}", "date": "{{dm1}}", "description": "Paie anonyme", "amount": "200000" }

?? status == 401

