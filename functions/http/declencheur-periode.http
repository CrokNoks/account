### Import : la paie d'il y a 10 jours déclenche la bascule, la ligne Courses (dm28) a pour équivalent la pending du dm30
# @name import6
POST {{api}}/{{acc6.id}}/transactions/bulk
Authorization: Bearer {{alice.access_token}}
Content-Type: application/json

{ "transactions": [
  { "categoryId": "{{sal6.id}}", "date": "{{dm10}}", "description": "Paie import", "amount": "200000" },
  { "categoryId": "{{bill6.id}}", "date": "{{dm28}}", "description": "Courses importées", "amount": "-8200" }
] }

?? status == 201
?? js response.parsedBody.length == 2
?? js response.parsedBody.find(t => t.periodSwitch).periodSwitch.removedPending == 1
# la pending Loisirs (sans équivalent) reste dans la période close
?? js response.parsedBody.find(t => t.periodSwitch).periodSwitch.remainingPending == 1

