### Paie récurrente, jour du mois de (aujourd'hui + 20) : la prochaine occurrence à au moins 15 jours est dans 20 jours
# (jour 29 à 31 : choisir un autre jour de lancement, le mois court ramène le jour)
# @name rec3
POST {{api}}/{{acc3.id}}/recurring
Authorization: Bearer {{alice.access_token}}
Content-Type: application/json

{ "categoryId": "{{sal3.id}}", "description": "Salaire Exemple", "amount": "250000", "dayOfMonth": {{dayOfPay}} }

?? status == 201

### Paie prévue dans 12 jours (pending)
# @name pay3
POST {{api}}/{{acc3.id}}/transactions
Authorization: Bearer {{alice.access_token}}
Content-Type: application/json

{ "categoryId": "{{sal3.id}}", "date": "{{dp12}}", "description": "Salaire Exemple", "amount": "250000", "pending": true, "metadata": { "source": "recurring", "recurringId": "{{rec3.id}}" } }

?? status == 201
?? js JSON.stringify(response.parsedBody).includes('periodSwitch') == false

### Facture prévue dans 5 jours (pending, autre catégorie)
# @name facture3
POST {{api}}/{{acc3.id}}/transactions
Authorization: Bearer {{alice.access_token}}
Content-Type: application/json

{ "categoryId": "{{bill3.id}}", "date": "{{dp5}}", "description": "Facture EDF", "amount": "-8000", "pending": true }

?? status == 201

### CA3 : sortir la facture du pending garde sa date et ne bascule rien
PATCH {{api}}/{{acc3.id}}/transactions/{{facture3.id}}
Authorization: Bearer {{alice.access_token}}
Content-Type: application/json

{ "pending": false }

?? status == 200
?? js response.parsedBody.date.slice(0, 10) == {{dp5}}
?? js JSON.stringify(response.parsedBody).includes('periodSwitch') == false

### CA3 : Bob (non membre) ne peut pas sortir la paie du pending
PATCH {{api}}/{{acc3.id}}/transactions/{{pay3.id}}
Authorization: Bearer {{bob.access_token}}
Content-Type: application/json

{ "pending": false }

?? status == 404

### CA3 : Alice pointe la paie prévue dans 12 jours (la date envoyée est ignorée) : date du jour, bascule
# @name sortie3
PATCH {{api}}/{{acc3.id}}/transactions/{{pay3.id}}
Authorization: Bearer {{alice.access_token}}
Content-Type: application/json

{ "reconciled": true, "date": "{{dm50}}" }

?? status == 200
?? js response.parsedBody.date.slice(0, 10) == {{today}}
?? js response.parsedBody.pending == false
?? js response.parsedBody.periodSwitch.dateChanged == true
?? js response.parsedBody.periodSwitch.closed.endDate == {{dm1}}
?? js response.parsedBody.periodSwitch.opened.startDate == {{today}}
# règle A : la nouvelle période finit la veille de la prochaine paie
?? js response.parsedBody.periodSwitch.opened.endDate == {{dp19}}

### CA2/CA5 : une seule période active, la nouvelle
GET {{api}}/{{acc3.id}}/periods
Authorization: Bearer {{alice.access_token}}

?? status == 200
?? js response.parsedBody.filter(p => p.isActive).length == 1
?? js response.parsedBody.length == 2

### CA8 : la prochaine paie existe une seule fois en pending, au lendemain de la fin (hors période)
GET {{api}}/{{acc3.id}}/transactions?categoryId={{sal3.id}}&pending=true
Authorization: Bearer {{alice.access_token}}

?? status == 200
?? js response.parsedBody.data.length == 1
?? js response.parsedBody.data[0].date.slice(0, 10) == {{dp20}}
?? js response.parsedBody.data[0].metadata.recurringId == {{rec3.id}}

