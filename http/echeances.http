# Écran Échéances : trésorerie (GET /reporting/cashflow : lowPoint, récurrence déjà payée) et calendrier (GET /reporting/calendar : pending).
# Lancement : npx httpyac send --all http/echeances.http --var port=<port du back local> --var anon=<ANON_KEY de `supabase status`>
# Jamais contre la production. Utilisateurs jetables, créés par le fichier.
# Les dates « aujourd'hui » viennent de l'horloge de la machine (le back lit le fuseau métier : relancer hors de la minute de minuit).
@baseUrl = http://localhost:{{port}}
@authUrl = http://127.0.0.1:54321/auth/v1
@today = {{$datetime "YYYY-MM-DD"}}
@dom = {{$datetime "D"}}
@year = {{$datetime "YYYY"}}
@month = {{$datetime "M"}}

### Utilisateur jetable
# @name login
POST {{authUrl}}/signup
apikey: {{anon}}
Content-Type: application/json

{ "email": "echeances-{{$timestamp}}@example.com", "password": "Password123!" }

?? status == 200

### Autre utilisateur connecté
# @name other
POST {{authUrl}}/signup
apikey: {{anon}}
Content-Type: application/json

{ "email": "echeances-autre-{{$timestamp}}@example.com", "password": "Password123!" }

?? status == 200

### Compte : solde de départ 1000,00 €
# @name account
POST {{baseUrl}}/accounts
Authorization: Bearer {{login.access_token}}
Content-Type: application/json

{ "name": "echeances-{{$timestamp}}", "initialBalance": "100000" }

?? status == 201

### Sans récurrence : point bas = solde du jour, aucun événement
# @name empty
GET {{baseUrl}}/{{account.id}}/reporting/cashflow?days=30
Authorization: Bearer {{login.access_token}}

?? status == 200
?? js response.parsedBody.events.length == 0
?? js response.parsedBody.lowPoint.balance == "100000"
?? js response.parsedBody.lowPoint.date.startsWith(`{{today}}`)

### Récurrence due aujourd'hui : Internet -30,00 €
# @name rec
POST {{baseUrl}}/{{account.id}}/recurring
Authorization: Bearer {{login.access_token}}
Content-Type: application/json

{ "description": "Internet", "amount": "-3000", "dayOfMonth": {{dom}} }

?? status == 201

### Non payée : comptée (événement aujourd'hui, point bas = solde - 30,00 €)
GET {{baseUrl}}/{{account.id}}/reporting/cashflow?days=30
Authorization: Bearer {{login.access_token}}

?? status == 200
?? js response.parsedBody.events[0].description == "Internet"
?? js response.parsedBody.events[0].projectedBalance == "97000"
?? js response.parsedBody.lowPoint.balance == "97000"

### Calendrier : la récurrence est projetée aujourd'hui, pending faux
GET {{baseUrl}}/{{account.id}}/reporting/calendar?year={{year}}&month={{month}}
Authorization: Bearer {{login.access_token}}

?? status == 200
?? js response.parsedBody.some(e => e.type == "recurring" && e.pending === false)

### Transaction d'aujourd'hui : prélèvement Internet -30,00 € (déjà payée)
# @name paid
POST {{baseUrl}}/{{account.id}}/transactions
Authorization: Bearer {{login.access_token}}
Content-Type: application/json

{ "date": "{{today}}", "description": "Prélèvement INTERNET", "amount": "-3000" }

?? status == 201

### Payée aujourd'hui : comptée une fois (dans le solde), pas dans les événements
GET {{baseUrl}}/{{account.id}}/reporting/cashflow?days=30
Authorization: Bearer {{login.access_token}}

?? status == 200
?? js response.parsedBody.currentBalance == "97000"
?? js response.parsedBody.events.filter(e => e.description == "Internet" && e.date.startsWith(`{{today}}`)).length == 0
?? js response.parsedBody.lowPoint.balance == "97000"

### Calendrier : même décision, la récurrence d'aujourd'hui n'est plus projetée
GET {{baseUrl}}/{{account.id}}/reporting/calendar?year={{year}}&month={{month}}
Authorization: Bearer {{login.access_token}}

?? status == 200
?? js response.parsedBody.filter(e => e.type == "recurring" && e.description == "Internet" && e.date.startsWith(`{{today}}`)).length == 0
?? js response.parsedBody.some(e => e.type == "actual" && e.pending === false)

### Facture en attente d'aujourd'hui (pending) : exposée avec pending vrai
POST {{baseUrl}}/{{account.id}}/transactions
Authorization: Bearer {{login.access_token}}
Content-Type: application/json

{ "date": "{{today}}", "description": "Facture eau", "amount": "-1000", "pending": true }

?? status == 201

### Calendrier : la facture porte pending vrai
GET {{baseUrl}}/{{account.id}}/reporting/calendar?year={{year}}&month={{month}}
Authorization: Bearer {{login.access_token}}

?? status == 200
?? js response.parsedBody.some(e => e.description == "Facture eau" && e.pending === true)

### Horizons : 60 et 90 jours acceptés, point bas présent
GET {{baseUrl}}/{{account.id}}/reporting/cashflow?days=90
Authorization: Bearer {{login.access_token}}

?? status == 200
?? js typeof response.parsedBody.lowPoint.balance == "string"

### Horizon invalide : 400
GET {{baseUrl}}/{{account.id}}/reporting/cashflow?days=1000
Authorization: Bearer {{login.access_token}}

?? status == 400

### Autre utilisateur connecté : refusé
GET {{baseUrl}}/{{account.id}}/reporting/cashflow?days=30
Authorization: Bearer {{other.access_token}}

?? status >= 403

### Anonyme : 401
GET {{baseUrl}}/{{account.id}}/reporting/cashflow?days=30

?? status == 401
