    "ra-i18n-polyglot": "^5.13.3",
    "ra-language-english": "^5.13.3",
    "ra-language-french": "^5.13.3",
    "ra-ui-materialui": "^5.13.2",
    "react": "^18.2.0",
    "react-admin": "^5.13.2",
    "react-dom": "^18.2.0",
    "recharts": "^3.5.1",
    "tesseract.js": "^7.0.0"
